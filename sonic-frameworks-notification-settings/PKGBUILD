pkgname=sonic-frameworks-notification-settings
pkgver=6.30.0
pkgrel=1
pkgdesc='Configuration system for SonicDE notify'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-frameworks-notification-settings'
license=(
	'LGPL-2.0-only'
	'LGPL-3.0-only'
)
depends=(
	'glibc'
	'libcanberra'
	'libstdc++'
	'qt6-base'
	'sonic-frameworks-internationalization'
	'sonic-frameworks-io'
	'sonic-frameworks-settings'
)
makedepends=(
	'doxygen'
	'qt6-tools'
	'sonic-frameworks-cmake-modules'
)
provides=('knotifyconfig')
conflicts=('knotifyconfig')
groups=('sonicde-frameworks')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('f0a42701d312ee62867813b250178ead312020493ddbf721afa35074867ff3e1')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
