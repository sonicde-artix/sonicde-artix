# Maintainer: callmetango

pkgname=sonic-login-manager-runit
pkgver=20260601
pkgrel=2
pkgdesc='runit service scripts for sonic-login-manager'
arch=(any)
url='https://github.com/Sonic-DE/sonic-login-manager'
license=(BSD)
groups=(sonicde)
depends=(sonic-login-manager init-logind)
provides=(init-sonic-login-manager init-displaymanager)
conflicts=(init-sonic-login-manager)
source=('soniclogin.run' 'soniclogin.log.run')
sha256sums=('09d2783c93222800fdf885d02045e8390d64a902a8545d8a763ba48b9e8e618c'
            '8c905514579d206be8aa4053813a2f98fe6d0cc71a88bea9876738e5ba98a62f')

package() {
    cd "$srcdir"
    install -Dm755 soniclogin.run "$pkgdir/etc/runit/sv/soniclogin/run"
    install -Dm755 soniclogin.log.run "$pkgdir/etc/runit/sv/soniclogin/log/run"
}
