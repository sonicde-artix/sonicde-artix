# Contributor: Andrea Scarpino <andrea@archlinux.org>
# Contributor: Balló György <ballogyor+arch at gmail dot com>

pkgname=sonic-frameworks-sso
pkgver=8.61.2.1
pkgrel=1
pkgdesc='A D-Bus service which performs user authentication on behalf of its clients'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-frameworks-sso'
license=('LGPL')
depends=(
	'glibc'
	'libgcc'
	'qt6-base'
)
makedepends=(
	'cmake'
	'doxygen'
	'graphviz'
	'ttf-font'
)
provides=('signond')
conflicts=('signond')
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('f1bd69e48bed8e013a4994ef7ddbff0ec96a82a17cb8ec4619e8e3e236d7a30d')

build() {
	cmake -B build -S "$pkgbase-$pkgver" \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	# Do not ship docs
	rm -rf "$pkgdir"/usr/share/doc
}
