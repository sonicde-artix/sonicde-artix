pkgname=sonic-system-info
pkgver=6.7.5
pkgrel=3
pkgdesc='A utility that provides information about a computer system'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-system-info'
license=('LGPL-2.0-or-later')
depends=(
	'aha'
	'clinfo'
	'dmidecode'
	'glibc'
	'glu'
	'iproute2' # ip
	'libdisplay-info'
	'libdrm'
	'libpulse' # pactl
	'libstdc++'
	'libudev.so'
	'libusb'
	'lm_sensors'
	'mesa-utils'
	'qt6-base'
	'qt6-declarative'
	'sh'
	'sonic-frameworks-app-info'
	'sonic-frameworks-auth'
	'sonic-frameworks-core-addons'
	'sonic-frameworks-device-integration'
	'sonic-frameworks-internationalization'
	'sonic-frameworks-io'
	'sonic-frameworks-qml-bridge'
	'sonic-frameworks-quick-ui'
	'sonic-frameworks-settings'
	'sonic-frameworks-settings-utils'
	'sonic-system-settings'
	'vulkan-tools'
	'wayland-utils'
	'xorg-xdpyinfo'
)
makedepends=(
	'fwupd'
	'sonic-frameworks-cmake-modules'
	'sonic-frameworks-doctools'
	'vulkan-headers'
)
optdepends=(
	'fwupd: firmware security module'
	'sonic-disks: SMART devices health monitor'
)
provides=('kinfocenter')
conflicts=('kinfocenter')
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('1099c7c3df53c18290671a650a41ad9fa748df86a919171753ec26f66421dbc4')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
