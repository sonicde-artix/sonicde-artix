pkgname=sonic-frameworks-internationalization
pkgver=6.30.0
pkgrel=1
pkgdesc='Advanced internationalization framework'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-frameworks-internationalization'
license=(
	'LGPL-2.0-only'
	'LGPL-3.0-only'
)
depends=(
	'glibc'
	'iso-codes'
	'libstdc++'
	'qt6-base'
)
makedepends=(
	'doxygen'
	'python'
	'qt6-declarative'
	'qt6-tools'
	'sonic-frameworks-cmake-modules'
)
optdepends=(
	'python: to compile .ts files'
	'qt6-declarative: ktranscript plugin and QML bindings'
)
provides=('ki18n')
conflicts=('ki18n')
groups=('sonicde-frameworks')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('d2700db5b8749b9f5f411ce2d4025d4bbec72eb593e735eb20d9b40d48b4f467')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
