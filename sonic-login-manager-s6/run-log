#!/bin/execlineb -P

envfile -I /etc/s6/config/soniclogin.conf
importas -sCuD "n3 s2000000 T" DIRECTIVES DIRECTIVES

ifelse { test -w /var/log } {
	foreground { install -d -o s6log -g s6log /var/log/sonic/login }
	s6-setuidgid s6log exec -c s6-log -d3 -b -- ${DIRECTIVES} /var/log/sonic/login
}
foreground { install -d -o s6log -g s6log /run/log/sonic/login }
s6-setuidgid s6log exec -c s6-log -d3 -b -- ${DIRECTIVES} /run/log/sonic/login
