pkgname=sonic-interface-libraries
pkgver=6.7.5
pkgrel=1
pkgdesc='SonicDE library and runtime components'
arch=(x86_64)
url='https://github.com/Sonic-DE/sonic-interface-libraries'
license=(LGPL-2.0-or-later)
depends=(glibc
         kconfig
         ki18n
         knotifications
         kpackage
         ksvg
         kwidgetsaddons
         libgcc
         libglvnd
         libstdc++
         libx11
         libxcb
         qt6-5compat
         qt6-base
         qt6-declarative
         sonic-activities
         sonic-frameworks-color-scheme
         sonic-frameworks-core-addons
         sonic-frameworks-gui-addons
         sonic-frameworks-icon-themes
         sonic-frameworks-io
         sonic-frameworks-keybind
         sonic-frameworks-quick-ui
         sonic-frameworks-windowsystem)
makedepends=(sonic-frameworks-cmake-modules
             sonic-frameworks-doctools)
provides=(libplasma)
conflicts=(libplasma plasma-framework)
replaces=(plasma-framework)
groups=(sonicde)
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('be7ee63241501d9308f7e4ee0e95d279ae458c9255c6ee7e71d759297a78a999')

build() {
  cmake -B build  -S $pkgname-$pkgver \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
