pkgname=sonic-oxygen-sounds
pkgdesc='The Oxygen Sound Theme'
pkgver=6.7.5
pkgrel=1
arch=('any')
url='https://github.com/Sonic-DE/sonic-oxygen-sounds'
license=('LGPL-2.0-or-later')
depends=()
makedepends=('sonic-frameworks-cmake-modules')
provides=('oxygen-sounds')
conflicts=('oxygen-sounds')
options=('!debug')
groups=('sonicde')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('a6df5e6de2014df4f0db274ef49b6422b9362a0c10d2e4bc7f572abfa1784377')

build() {
	cmake -B build -S "$pkgname-$pkgver"
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
